{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug desktop build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release desktop build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "headless-ci",
      "inherits": "base",
      "displayName": "Headless CI build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ORBITLAB_BUILD_APP": "OFF"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "Address and undefined-behavior sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ORBITLAB_BUILD_APP": "OFF",
        "ORBITLAB_ENABLE_ASAN": "ON",
        "ORBITLAB_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Thread sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ORBITLAB_BUILD_APP": "OFF",
        "ORBITLAB_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Coverage-instrumented tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ORBITLAB_BUILD_APP": "OFF",
        "ORBITLAB_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "base",
      "displayName": "Clang static analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ORBITLAB_BUILD_APP": "OFF",
        "ORBITLAB_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "JSON persistence fuzzer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "ORBITLAB_BUILD_APP": "OFF",
        "ORBITLAB_BUILD_TESTS": "OFF",
        "ORBITLAB_BUILD_BENCHMARK": "OFF",
        "ORBITLAB_BUILD_FUZZER": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "headless-ci", "configurePreset": "headless-ci" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "clang-tidy", "configurePreset": "clang-tidy" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "headless-ci",
      "configurePreset": "headless-ci",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": { "outputOnFailure": true }
    }
  ]
}
